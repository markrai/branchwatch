<UserControl x:Class="BranchWatch.StickyNoteSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <StackPanel Margin="0">
            <TextBlock Text="Default appearance" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Choose the appearance of newly created notes." Foreground="#617083" TextWrapping="Wrap"
                       Margin="0,0,0,20"/>
            <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ListBox x:Name="ColorBox" SelectedValuePath="Name" SelectionChanged="OnColorChanged"
                     AutomationProperties.Name="Default note color" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,18">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Margin" Value="0,0,5,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="SwatchFrame" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Padding="4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="SwatchFrame" Property="BorderBrush" Value="#315EAE"/></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwatchFrame" Property="Background" Value="#EDF2F8"/></Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SwatchFrame" Property="Background" Value="#E2EAF5"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="54">
                            <Border Width="36" Height="32" Background="{Binding Body}" BorderBrush="{Binding Header}" BorderThickness="1" CornerRadius="5"/>
                            <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Transparency" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Slider x:Name="TransparencySlider" Minimum="1" Maximum="10" TickFrequency="1"
                    IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    ValueChanged="OnTransparencyChanged" AutomationProperties.Name="Default note transparency"/>
            <DockPanel Margin="0,4,0,6">
                <TextBlock Text="1 · Opaque" DockPanel.Dock="Left"/>
                <TextBlock Text="10 · Most transparent" TextAlignment="Right"/>
            </DockPanel>
            <TextBlock x:Name="TransparencyLabel" TextAlignment="Center" Margin="0,0,0,16"/>
            <Border Background="#E2E7ED" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <Border Height="5" Width="240" Background="#AAB8C7" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <Border Height="5" MaxWidth="285" Width="250" Background="#AAB8C7" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <Border Height="5" Width="190" Background="#AAB8C7" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border x:Name="PreviewSurface" CornerRadius="4" Width="240" HorizontalAlignment="Center">
                        <StackPanel>
                            <Border x:Name="PreviewHeader" Padding="9,6" CornerRadius="4,4,0,0">
                                <TextBlock Text="Sticky note" FontWeight="SemiBold" Foreground="#332D24"/>
                            </Border>
                            <TextBlock Text="Your next note" Foreground="#29251F" FontSize="16" Padding="12,14"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="Levels 2–10 allow clicks through the note body. Use level 1 to edit; the header always remains interactive." TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="Save defaults to affect future notes only. Apply to all notes also replaces existing colors and transparency, including closed notes on other desktops."
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" MinHeight="20" Margin="0,0,0,8"
                       AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Save defaults" Click="OnSaveDefaults" Padding="12,7" Margin="0,0,8,4" IsDefault="True"/>
                <Button x:Name="ApplyAllButton" Style="{DynamicResource PrimaryButton}" Content="Apply to all notes" Click="OnApplyAll"
                        Padding="12,7" Margin="0,0,8,4"/>
                
            </WrapPanel>
        </StackPanel>
</UserControl>
