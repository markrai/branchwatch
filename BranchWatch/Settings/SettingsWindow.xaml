<Window x:Class="BranchWatch.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BranchWatch Settings" Icon="pack://application:,,,/BranchWatch;component/Assets/BranchWatch.ico"
    Width="820" Height="690" MinWidth="620" MinHeight="420" WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI" FontSize="13" Foreground="#243041" Background="#F7F9FC"
    UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#243041"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#617083"/>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="Foreground" Value="#315EAE"/>
        </Style>
        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#315EAE"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource StandardButton}"/>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
            <Setter Property="Background" Value="#315EAE"/>
            <Setter Property="BorderBrush" Value="#315EAE"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE4ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#E8EEF6"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#DDE8F8"/>
                                <Setter Property="Foreground" Value="#214D97"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#D5E2F4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#EEF2F7" BorderBrush="#DDE4ED" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,20,12,16">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,26">
                    <Image Source="pack://application:,,,/BranchWatch;component/Assets/BranchWatch.ico" Width="36" Height="36" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                    <TextBlock Text="BranchWatch" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="SETTINGS" FontSize="10" Foreground="#617083" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock x:Name="SidebarVersion" DockPanel.Dock="Bottom" Foreground="#617083" FontSize="11" Margin="8,12,0,0"/>
                <ListBox x:Name="Navigation" SelectionChanged="OnNavigationChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NavigationItem}">
                    <ListBoxItem Tag="General"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Width="25" FontSize="16"/><TextBlock Text="General"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="GitWatcher"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" Width="25" FontSize="16"/><TextBlock Text="Git Watcher"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="VirtualDesktops"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" Width="25" FontSize="16"/><TextBlock Text="Virtual Desktops"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="StickyNotes"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70B;" Width="25" FontSize="16"/><TextBlock Text="Sticky Notes"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="About"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" Width="25" FontSize="16"/><TextBlock Text="About"/></StackPanel></ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="28,24,28,16">
                <TextBlock x:Name="SectionTitle" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="SectionDescription" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,28,8">
                <Grid>
                    <StackPanel x:Name="GeneralPage">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Startup" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="StartupCheck" Content="Start with Windows" Click="OnStartupClick"/>
                                <TextBlock Text="Keep BranchWatch available in the notification area after signing in." Style="{StaticResource Description}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Storage" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Settings and sticky notes are saved locally in this folder." Style="{StaticResource Description}"/>
                                <Border Background="#F1F4F8" CornerRadius="5" Padding="11" Margin="0,0,0,12">
                                    <TextBlock x:Name="StoragePath" FontFamily="Consolas" FontSize="12"/>
                                </Border>
                                <Button Content="Open data folder" HorizontalAlignment="Left" Click="OnOpenFolder"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="GitPage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Repository monitoring" Style="{StaticResource CardTitle}"/>
                                <RadioButton x:Name="PinnedMode" GroupName="WatchMode" Content="Pinned repository" Click="OnPinnedMode"/>
                                <RadioButton x:Name="WorkspaceMode" GroupName="WatchMode" Content="Workspace" Click="OnWorkspaceMode"/>
                                <TextBlock Text="Pinned repository" FontWeight="SemiBold" Margin="0,15,0,6"/>
                                <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="OnChooseRepository" Margin="8,0,0,0"/>
                                    <Border Background="#F1F4F8" CornerRadius="5" Padding="9"><TextBlock x:Name="RepositoryPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Border>
                                </DockPanel>
                                <TextBlock Text="Workspace folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Browse..." Click="OnChooseWorkspace" Margin="8,0,0,0"/>
                                    <Border Background="#F1F4F8" CornerRadius="5" Padding="9"><TextBlock x:Name="WorkspacePath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Border>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Overlay appearance" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="GitOverlayCheck" Content="Show overlay" Click="OnGitOverlayClick" Margin="0,0,0,12"/>
                                <ContentControl x:Name="GitOverlayHost"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="DesktopsPage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel><TextBlock Text="Overlay appearance" Style="{StaticResource CardTitle}"/><ContentControl x:Name="DesktopOverlayHost"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Desktop-specific colors" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Give each desktop its own label color. Reset restores the default. Colors follow the desktop when it is renamed or reordered." Style="{StaticResource Description}"/>
                                <StackPanel x:Name="DesktopColorRows"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="NotesPage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}"><ContentControl x:Name="NotesHost"/></Border>
                    </StackPanel>
                    <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Image Source="pack://application:,,,/BranchWatch;component/Assets/BranchWatch.ico" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                <TextBlock Text="BranchWatch" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AboutVersion" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16"/>
                                <TextBlock Text="Git monitoring, virtual desktop overlays, and sticky notes in one lightweight Windows application." Style="{StaticResource Description}"/>
                                <Button Content="View GitHub repository" HorizontalAlignment="Left" Click="OnOpenRepository"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="#DDE4ED" BorderThickness="0,1,0,0" Padding="28,12" Background="White">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Close" MinWidth="82" Click="OnClose"/>
                    <TextBlock x:Name="FooterText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
