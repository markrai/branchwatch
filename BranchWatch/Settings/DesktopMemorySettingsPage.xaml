<UserControl x:Class="BranchWatch.DesktopMemorySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock Text="1 · Choose a desktop" Style="{DynamicResource CardTitle}"/>
                <TextBlock Text="Select a virtual desktop. Capture is available only while that desktop is active." Style="{DynamicResource Description}"/>
                <ComboBox x:Name="DesktopPicker" DisplayMemberPath="Label" SelectedValuePath="Id" MinHeight="34"
                          SelectionChanged="OnDesktopSelected" AutomationProperties.Name="Virtual desktop"/>
                <TextBlock x:Name="CaptureHint" Foreground="#617083" Margin="0,8,0,12" TextWrapping="Wrap"/>
                <WrapPanel>
                    <Button x:Name="CaptureButton" Content="Capture layout" Style="{DynamicResource PrimaryButton}" Click="OnCapture" Margin="0,0,8,6"/>
                    <Button Content="Refresh" Click="OnRefresh" Margin="0,0,8,6"/>
                    <Button x:Name="PreviewButton" Content="Preview restoration" Click="OnPreview" Margin="0,0,8,6"/>
                    <Button x:Name="DeleteButton" Content="Delete snapshot" Click="OnDelete" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock x:Name="StatusText" Foreground="#617083" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
        <Border x:Name="EmptyCard" Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock Text="No saved snapshot" Style="{DynamicResource CardTitle}"/>
                <TextBlock Text="Capture your current layout to see a preview here. Nothing is saved until you confirm." Foreground="#617083" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border x:Name="SnapshotCard" Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock x:Name="SnapshotHeading" Style="{DynamicResource CardTitle}"/>
                <TextBlock x:Name="SnapshotSummary" Style="{DynamicResource Description}"/>
                <WrapPanel Margin="0,0,0,10">
                    <Button x:Name="SaveButton" Content="Save snapshot" Style="{DynamicResource PrimaryButton}" Click="OnSave" Margin="0,0,8,6"/>
                    <Button x:Name="DiscardButton" Content="Discard capture" Click="OnDiscard" Margin="0,0,8,6"/>
                </WrapPanel>
                <Border Background="#EEF2F7" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                    <Viewbox Stretch="Uniform" MaxHeight="220">
                        <Canvas x:Name="MonitorCanvas" Width="420" Height="210" ClipToBounds="True" Background="Transparent"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="Schematic preview · numbers correspond to the monitor list" Foreground="#617083" FontSize="11" Margin="0,0,0,12"/>
                <Expander x:Name="InventoryExpander" Header="Captured monitors and windows" IsExpanded="True" Margin="0,0,0,8">
                <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Monitors" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="MonitorRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDE4ED" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#617083" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Application windows" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <ItemsControl x:Name="WindowRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDE4ED" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Label}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#617083" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
                </Expander>
                <StackPanel x:Name="FolderEditor" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock Text="Application folders" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Optional: associate a local folder with a captured Explorer, Cursor, VS Code or Windows Terminal window. This is your chosen reopen location, not an inferred running process command line." Foreground="#617083" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ComboBox x:Name="FolderWindowPicker" DisplayMemberPath="Label" SelectedValuePath="Id" MinHeight="32" SelectionChanged="OnFolderWindowSelected" AutomationProperties.Name="Window to configure"/>
                    <TextBlock x:Name="FolderContextText" Foreground="#617083" TextWrapping="Wrap" Margin="0,6,0,6"/>
                    <WrapPanel>
                        <Button x:Name="ChooseFolderButton" Content="Choose folder..." Click="OnChooseFolder" Margin="0,0,8,6"/>
                        <Button x:Name="ClearFolderButton" Content="Clear folder" Click="OnClearFolder" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="BrowserEditor" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock Text="Browser sessions" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel x:Name="BrowserCaptureControls">
                        <TextBlock Text="Choose a captured normal Chrome or Edge window, generate a code, and send tabs from Companion in that window." Foreground="#617083" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ComboBox x:Name="BrowserWindowPicker" DisplayMemberPath="Label" SelectedValuePath="Id" MinHeight="32" SelectionChanged="OnBrowserWindowSelected" AutomationProperties.Name="Browser window to capture"/>
                        <WrapPanel Margin="0,8,0,6">
                            <Button x:Name="ArmBrowserButton" Content="Generate capture code" Click="OnArmBrowser" Margin="0,0,8,6"/>
                            <Button x:Name="ImportBrowserButton" Content="Import received tabs" Click="OnImportBrowser" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <TextBox x:Name="BrowserTicketText" IsReadOnly="True" AutomationProperties.Name="One-time capture code" Margin="0,0,0,8"/>
                    </StackPanel>
                    <TextBlock Text="Review full URLs before saving. Query strings and fragments may contain private tokens. Tab selection does not change your live browser." Foreground="#8C5918" TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <TextBlock x:Name="BrowserReviewSummary" Foreground="#315EAE" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                    <ItemsControl x:Name="BrowserRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDE4ED" BorderThickness="0,1,0,0" Padding="0,10" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="#617083" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6"/>
                                        <WrapPanel Margin="0,0,0,6" IsEnabled="{Binding Editable}">
                                            <WrapPanel.Style>
                                                <Style TargetType="WrapPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Editable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Style>
                                            <Button Content="Select all tabs" Tag="all" Click="OnSelectBrowserTabs" Margin="0,0,8,4"/>
                                            <Button Content="Clear selection" Tag="none" Click="OnSelectBrowserTabs" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                        <TextBlock Text="No tabs selected for this saved browser window." TextWrapping="Wrap" Foreground="#617083">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tabs.Length}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RestoreHint}" Foreground="#617083" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                        <Button Content="Reopen saved tabs" Click="OnArmBrowserRestore" HorizontalAlignment="Left" Margin="0,0,0,6">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Restorable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Tabs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding Editable}" Click="OnBrowserTabSelectionChanged" AutomationProperties.Name="{Binding Url}" Margin="0,3,0,5" VerticalContentAlignment="Top">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#617083" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Url}" TextWrapping="Wrap" ToolTip="{Binding Url}"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="BrowserRestoreControls" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="Experimental browser reopening · one session at a time" FontWeight="SemiBold"/>
                        <TextBlock Text="Open the matching Chrome or Edge profile yourself, then redeem the code in Companion. Companion checks existing profile tabs before opening a new window. Native window placement is not enabled." Foreground="#617083" TextWrapping="Wrap" Margin="0,4,0,6"/>
                        <TextBox x:Name="BrowserRestoreCode" IsReadOnly="True" AutomationProperties.Name="One-time browser restore code" Margin="0,0,0,6"/>
                        <Button Content="Cancel restore code" Click="OnCancelBrowserRestore" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <TextBlock x:Name="BrowserRestoreStatus" Foreground="#315EAE" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <TextBlock Text="Excluding all tabs retains a browser session with no URLs; it cannot be reopened." Foreground="#617083" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="WarningsText" Foreground="#8C5918" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="Restore matching normal windows. Optional folder adapters can reopen a chosen project or directory." Foreground="#617083" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Border x:Name="PlanCard" Visibility="Collapsed" Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock Text="3 · Review restoration" Style="{DynamicResource CardTitle}"/>
                <TextBlock x:Name="PlanSummary" Style="{DynamicResource Description}"/>
                <TextBlock Text="Unmatched monitors" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="FallbackPicker" SelectedIndex="0" MinHeight="34" SelectionChanged="OnFallbackChanged"
                          AutomationProperties.Name="Unmatched monitor policy">
                    <ComboBoxItem Content="Skip affected windows"/>
                    <ComboBoxItem Content="Preview on primary monitor"/>
                </ComboBox>
                <Border Background="#EEF2F7" CornerRadius="8" Padding="10" Margin="0,14,0,8">
                    <Viewbox Stretch="Uniform" MaxHeight="220">
                        <Canvas x:Name="PlanCanvas" Width="420" Height="210" ClipToBounds="True" Background="Transparent"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="Current monitors · selected proposed windows only, not actual windows." Foreground="#617083" FontSize="11" Margin="0,0,0,12"/>
                <TextBlock Text="Monitor matching" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="MatchRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDE4ED" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#617083" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Choose windows to restore" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBlock Text="Windows needing review start unchecked. Unchecked windows will not be moved or launched." Foreground="#617083" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="SelectSafeButton" Content="Select ready placements" Click="OnSelectSafe" Margin="0,0,8,6"/>
                    <Button x:Name="SelectAllButton" Content="Select all eligible" Click="OnSelectAll" Margin="0,0,8,6"/>
                    <Button x:Name="SelectNoneButton" Content="Clear selection" Click="OnSelectNone" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock x:Name="SelectionSummary" Foreground="#315EAE" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ItemsControl x:Name="PlanRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDE4ED" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding Eligible}" Click="OnPlanSelectionChanged" FontWeight="SemiBold" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#617083" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="PlanWarnings" Foreground="#8C5918" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <CheckBox x:Name="LaunchMissingCheck" Content="Launch eligible missing applications" Margin="0,14,0,0"
                          ToolTip="Launch an eligible missing window, optionally with a saved folder. Brokered folder openings are not automatically positioned."/>
                <TextBlock Text="Off by default. Applications may open their own startup windows or activate themselves." Foreground="#617083" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="RestoreButton" Content="Restore desktop..." Style="{DynamicResource PrimaryButton}" Click="OnRestore" Margin="0,0,8,6"/>
                    <Button Content="Refresh preview" Click="OnPreview" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock x:Name="RestoreHint" Foreground="#617083" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border x:Name="RestoreResultsCard" Style="{DynamicResource SettingsCard}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="4 · Restore results" Style="{DynamicResource CardTitle}"/>
                <TextBlock x:Name="RestoreSummary" Style="{DynamicResource Description}" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="RestoreProgress" Height="8" Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" Margin="0,0,0,12" AutomationProperties.Name="Restore progress"/>
                <Button x:Name="CancelRestoreButton" Content="Cancel remaining operations" HorizontalAlignment="Left" Click="OnCancelRestore" Visibility="Collapsed" Margin="0,0,0,10"/>
                <ItemsControl x:Name="RestoreRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDE4ED" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Label}"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#617083" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock Text="Privacy" Style="{DynamicResource CardTitle}"/>
                <TextBlock Text="Snapshots contain application paths, window titles and display identifiers. They stay in your local application data folder. No screenshots, process command lines or environment variables are recorded." Foreground="#617083" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
