<UserControl x:Class="BranchWatch.DesktopMemorySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock Text="Working environment" Style="{DynamicResource CardTitle}"/>
                <TextBlock Text="Select a virtual desktop. Capture is available only while that desktop is active." Style="{DynamicResource Description}"/>
                <ComboBox x:Name="DesktopPicker" DisplayMemberPath="Label" SelectedValuePath="Id" MinHeight="34"
                          SelectionChanged="OnDesktopSelected" AutomationProperties.Name="Virtual desktop"/>
                <TextBlock x:Name="CaptureHint" Foreground="#617083" Margin="0,8,0,12" TextWrapping="Wrap"/>
                <WrapPanel>
                    <Button x:Name="CaptureButton" Content="Capture layout" Style="{DynamicResource PrimaryButton}" Click="OnCapture" Margin="0,0,8,6"/>
                    <Button Content="Refresh" Click="OnRefresh" Margin="0,0,8,6"/>
                    <Button x:Name="PreviewButton" Content="Preview restoration" Click="OnPreview" Margin="0,0,8,6"/>
                    <Button x:Name="DeleteButton" Content="Delete snapshot" Click="OnDelete" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock x:Name="StatusText" Foreground="#617083" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
        <Border x:Name="EmptyCard" Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock Text="No saved snapshot" Style="{DynamicResource CardTitle}"/>
                <TextBlock Text="Capture your current layout to see a preview here. Nothing is saved until you confirm." Foreground="#617083" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border x:Name="SnapshotCard" Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock x:Name="SnapshotHeading" Style="{DynamicResource CardTitle}"/>
                <TextBlock x:Name="SnapshotSummary" Style="{DynamicResource Description}"/>
                <Border Background="#EEF2F7" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                    <Viewbox Stretch="Uniform" MaxHeight="220">
                        <Canvas x:Name="MonitorCanvas" Width="420" Height="210" ClipToBounds="True" Background="Transparent"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="Schematic preview · numbers correspond to the monitor list" Foreground="#617083" FontSize="11" Margin="0,0,0,12"/>
                <TextBlock Text="Monitors" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="MonitorRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDE4ED" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#617083" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Application windows" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <ItemsControl x:Name="WindowRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDE4ED" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Label}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#617083" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="WarningsText" Foreground="#8C5918" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="SaveButton" Content="Save snapshot" Style="{DynamicResource PrimaryButton}" Click="OnSave" Margin="0,0,8,6"/>
                    <Button x:Name="DiscardButton" Content="Discard capture" Click="OnDiscard" Margin="0,0,8,6"/>
                </WrapPanel>
                <TextBlock Text="Restore matching normal windows. Optionally launch eligible missing applications without arguments." Foreground="#617083" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Border x:Name="PlanCard" Visibility="Collapsed" Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock Text="Restore preview" Style="{DynamicResource CardTitle}"/>
                <TextBlock x:Name="PlanSummary" Style="{DynamicResource Description}"/>
                <TextBlock Text="Unmatched monitors" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="FallbackPicker" SelectedIndex="0" MinHeight="34" SelectionChanged="OnFallbackChanged"
                          AutomationProperties.Name="Unmatched monitor policy">
                    <ComboBoxItem Content="Skip affected windows"/>
                    <ComboBoxItem Content="Preview on primary monitor"/>
                </ComboBox>
                <Border Background="#EEF2F7" CornerRadius="8" Padding="10" Margin="0,14,0,8">
                    <Viewbox Stretch="Uniform" MaxHeight="220">
                        <Canvas x:Name="PlanCanvas" Width="420" Height="210" ClipToBounds="True" Background="Transparent"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="Current monitors · window rectangles are proposed positions, not actual windows." Foreground="#617083" FontSize="11" Margin="0,0,0,12"/>
                <TextBlock Text="Monitor matching" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="MatchRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDE4ED" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#617083" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Planned windows" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <ItemsControl x:Name="PlanRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDE4ED" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Label}"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#617083" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="PlanWarnings" Foreground="#8C5918" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <CheckBox x:Name="LaunchMissingCheck" Content="Launch eligible missing applications" Margin="0,14,0,0"
                          ToolTip="Launch a single missing normal window per absent executable. No arguments or application state are restored."/>
                <TextBlock Text="Off by default. Applications may open their own startup windows or activate themselves." Foreground="#617083" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="RestoreButton" Content="Restore desktop..." Style="{DynamicResource PrimaryButton}" Click="OnRestore" Margin="0,0,8,6"/>
                    <Button Content="Refresh preview" Click="OnPreview" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock x:Name="RestoreHint" Foreground="#617083" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border x:Name="RestoreResultsCard" Style="{DynamicResource SettingsCard}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Restore results" Style="{DynamicResource CardTitle}"/>
                <TextBlock x:Name="RestoreSummary" Style="{DynamicResource Description}" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="CancelRestoreButton" Content="Cancel remaining operations" HorizontalAlignment="Left" Click="OnCancelRestore" Visibility="Collapsed" Margin="0,0,0,10"/>
                <ItemsControl x:Name="RestoreRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDE4ED" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Label}"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#617083" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource SettingsCard}">
            <StackPanel>
                <TextBlock Text="Privacy" Style="{DynamicResource CardTitle}"/>
                <TextBlock Text="Snapshots contain application paths, window titles and display identifiers. They stay in your local application data folder. No screenshots, process command lines or environment variables are recorded." Foreground="#617083" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
