<Window x:Class="BranchWatch.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="pack://application:,,,/BranchWatch;component/Assets/BranchWatch.ico"
        Title="Sticky note" Width="300" Height="260" MinWidth="220" MinHeight="150"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" WindowStartupLocation="Manual"
        ShowInTaskbar="True" Topmost="True" Background="Transparent" FontFamily="Segoe UI" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                            GlassFrameThickness="0" NonClientFrameEdges="None" CornerRadius="8"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#332D24"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5"
                                Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#39000000"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#66554A"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="NoteSurface" BorderBrush="#33000000" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Header" Background="#F6DE87" Margin="4,4,4,0"
                  MouseLeftButtonDown="HeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource HeaderButton}" Content="+" Click="NewClick"
                        ToolTip="New note" AutomationProperties.Name="New note"/>
                <TextBlock x:Name="DesktopLabel" Grid.Column="1" VerticalAlignment="Center"
                           Margin="5,0" FontSize="12" Foreground="#554B39"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="OptionsButton" Grid.Column="2" Style="{StaticResource HeaderButton}"
                        Content="⋯" Click="OptionsClick" ToolTip="Note options"
                        AutomationProperties.Name="Note options"/>
                <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Content="×"
                        Click="CloseClick" ToolTip="Close note" AutomationProperties.Name="Close note"/>
            </Grid>
            <Grid x:Name="BodyHost" Grid.Row="1">
            <TextBox x:Name="Editor" Margin="7,4,7,7" Padding="8,7"
                     Background="Transparent" BorderThickness="0" Foreground="#29251F"
                     FontSize="16" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     SpellCheck.IsEnabled="False" AutomationProperties.Name="Note text"/>
            </Grid>
        </Grid>
    </Border>
</Window>
