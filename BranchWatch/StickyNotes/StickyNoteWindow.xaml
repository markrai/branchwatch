<Window x:Class="BranchWatch.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="pack://application:,,,/BranchWatch;component/Assets/BranchWatch.ico"
        Title="Sticky note" Width="300" Height="260" MinWidth="220" MinHeight="150"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="True" Topmost="True" Background="Transparent" FontFamily="Segoe UI" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" NonClientFrameEdges="None" CornerRadius="8"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#332D24"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5"
                                Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#39000000"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#66554A"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="NoteSurface" BorderBrush="#33000000" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderSurface" Grid.Row="0" Background="#F6DE87"
                    MouseLeftButtonDown="HeaderMouseDown" ToolTip="Click to temporarily edit; drag to move">
                <Grid x:Name="Header" Margin="4,4,4,0" Focusable="True" KeyboardNavigation.IsTabStop="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource HeaderButton}" Content="+" Click="NewClick"
                            ToolTip="New note" AutomationProperties.Name="New note"/>
                    <TextBlock x:Name="DesktopLabel" Grid.Column="1" VerticalAlignment="Center"
                               Margin="5,0" FontSize="12" Foreground="#554B39"
                               TextTrimming="CharacterEllipsis" MouseLeftButtonDown="TitleMouseDown"
                               AutomationProperties.Name="Note title"/>
                    <TextBox x:Name="TitleEditor" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center"
                             Margin="3,0" Padding="3,2" FontSize="12" Foreground="#332D24"
                             Background="#40FFFFFF" BorderBrush="#66554A" BorderThickness="1"
                             MaxLength="120" AcceptsReturn="False" AutomationProperties.Name="Rename note"
                             LostKeyboardFocus="TitleEditorLostFocus"/>
                    <Button x:Name="CollapseButton" Grid.Column="2" Style="{StaticResource HeaderButton}"
                            Click="CollapseClick" ToolTip="Collapse note" AutomationProperties.Name="Collapse note">
                        <Path Width="14" Height="14" Data="M 2,11 L 12,11" Stroke="#332D24"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              IsHitTestVisible="False"/>
                    </Button>
                    <Button x:Name="OptionsButton" Grid.Column="3" Style="{StaticResource HeaderButton}"
                            Content="⋯" Click="OptionsClick" ToolTip="Note options"
                            AutomationProperties.Name="Note options"/>
                    <Button Grid.Column="4" Style="{StaticResource HeaderButton}" Content="×"
                            Click="CloseClick" ToolTip="Close note" AutomationProperties.Name="Close note"/>
                </Grid>
            </Border>
            <Grid x:Name="BodyHost" Grid.Row="1">
                <TextBox x:Name="Editor" Margin="7,4,7,7" Padding="8,7"
                         Background="Transparent" BorderThickness="0" Foreground="#29251F"
                         FontSize="16" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         SpellCheck.IsEnabled="False" AutomationProperties.Name="Note text">
                    <TextBox.Resources>
                        <ResourceDictionary Source="StickyNoteScrollBar.xaml"/>
                    </TextBox.Resources>
                </TextBox>
                <Thumb x:Name="ShrinkGrip" Width="18" Height="18" HorizontalAlignment="Left"
                       VerticalAlignment="Bottom" Cursor="SizeNESW" Focusable="False"
                       ToolTip="Drag inward to shrink or outward to restore the original size" AutomationProperties.Name="Resize note"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"
                       DragStarted="ShrinkDragStarted" DragDelta="ShrinkDragDelta"
                       DragCompleted="ShrinkDragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}">
                                <Path x:Name="GripLines" Data="M 3,8 L 11,16 M 3,13 L 6,16"
                                      Stroke="#332D24" StrokeThickness="1.25"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.38"
                                      IsHitTestVisible="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GripLines" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="GripLines" Property="Opacity" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Grid>
    </Border>
</Window>
