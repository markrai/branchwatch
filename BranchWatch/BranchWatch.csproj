<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BranchWatch</AssemblyName>
    <RootNamespace>BranchWatch</RootNamespace>
    <StartupObject>BranchWatch.Program</StartupObject>
    <ApplicationIcon>Assets\BranchWatch.ico</ApplicationIcon>
    <Version>1.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\BranchWatch.ico" />
  </ItemGroup>
</Project>
